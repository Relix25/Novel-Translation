{
  "plugins": ["react", "import", "jsx-a11y"],
  "categories": { "correctness": "error" },
  "env": { "browser": true, "es2022": true },
  "rules": {
    "react/purity": "off",
    "react/refs": "off",
    "react/immutability": "off",
    "react/set-state-in-effect": "off"
  },
  "ignorePatterns": ["dist/**", "node_modules/**"]
}
