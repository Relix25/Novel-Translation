* text=auto
*.py text eol=lf
*.jsx text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Archived benchmark sources are fingerprinted as bytes, including line endings.
benchmarks/corpus/*.txt -text -whitespace
benchmarks/corpus/*.html -text -whitespace
